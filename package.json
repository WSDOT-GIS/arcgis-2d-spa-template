{
	"name": "arcgis-2d-spa-template",
	"version": "0.0.2",
	"description": "Template for ArcGIS API single page application",
	"type": "module",
	"scripts": {
		"build": "bun ./tools/build.ts",
		"build-and-preview": "bun ./tools/build.ts && vite preview",
		"dev": "vite",
		"lint": "oxlint --fix",
		"lint:spell": "cspell lint . --relative --no-progress --no-summary --fail-fast",
		"preview": "vite preview",
		"format": "prettier --write --no-color --log-level silent .",
		"update-cdn-refs": "bun ./tools/upgrade-cdn-refs.ts"
	},
	"author": {
		"name": "Put your name here. If you only want to include your name you can replace this JSON object with just your name as a string.",
		"email": "YourGithubUserName@users.noreply.github.com",
		"url": "https://example.com/you/can/omit/the/url/if/you/dont/have/a/website"
	},
	"contributors": [
		{
			"name": "Jeff Jacobson",
			"email": "JeffJacobson@users.noreply.github.com"
		}
	],
	"private": true,
	"license": "Unlicense",
	"devDependencies": {
		"@prettier/plugin-oxc": "^0.0.4",
		"@types/bun": "latest",
		"@types/gh-pages": "^6.1.0",
		"@types/jsdom": "^27.0.0",
		"@types/node": "^24.9.1",
		"@wsdot/arcgis-core-helper": "^1.1.2",
		"cspell": "^9.2.2",
		"jsdom": "^27.0.1",
		"oxlint": "^1.24.0",
		"oxlint-tsgolint": "^0.2.1",
		"prettier": "^3.6.2",
		"semver-utils": "^1.1.4",
		"typescript": "^5.9.3",
		"vite": "npm:rolldown-vite@^7.1.19",
		"vite-plugin-oxlint": "^1.4.0"
	},
	"keywords": [
		"arcgis",
		"template",
		"WSDOT",
		"map",
		"spa",
		"single-page-app"
	],
	"dependencies": {
		"@arcgis/core": "^4.34.2",
		"@arcgis/map-components": "^4.34.3",
		"@esri/calcite-components": "^3.3.3"
	}
}
