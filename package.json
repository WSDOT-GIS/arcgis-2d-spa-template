		"update-cdn-refs": "bun ./tools/upgrade-cdn-refs.ts"
	},
	"dependencies": {
		"@arcgis/core": "^5.1.15",
		"@arcgis/map-components": "^5.1.15",
		"@esri/calcite-components": "^5.1.2"
	},
	"devDependencies": {
		"@prettier/plugin-oxc": "^0.2.2",
		"@types/bun": "1.3.14",
		"@types/gh-pages": "^6.1.0",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^26.1.2",
		"@wsdot/arcgis-core-helper": "^1.1.2",
		"cspell": "^10.0.1",
		"jsdom": "^30.0.1",
		"oxfmt": "^0.62.0",
		"oxlint": "^1.77.0",
		"oxlint-tsgolint": "^7.0.2001",
